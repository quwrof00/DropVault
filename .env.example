# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Origin of the backend that serves the REST API and the collaboration
# WebSocket server (e.g. https://dropvault-collab.onrender.com).
# The API base URL and the WebSocket URL are derived from it.
# Leave empty to talk to the origin the frontend is served from.
VITE_BACKEND_URL=http://localhost:1234

# Comma separated list of frontend origins allowed to call the API and to open
# a collaboration WebSocket. Leave empty to allow every origin (local dev).
ALLOWED_ORIGINS=http://localhost:5173

# Optional: Judge0 API key
# VITE_JUDGE0_API_KEY=
